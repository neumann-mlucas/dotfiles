# Taskwarrior 3.x house config, stowed from ~/.dotfiles.
# The live ~/.config/task/taskrc is a local file that includes this one,
# because `task context` and `task config` write to the main taskrc.
# Docs: man taskrc

data.location=~/.local/share/task
weekstart=Monday
search.case.sensitive=0
# A write command with no filter is an error, not a prompt.
allow.empty.filter=0

# Areas live in the project tree: work.<client>, dev.<repo>, home.
context.work.read=project:work
context.work.write=project:work
context.personal.read=project.not:work

# Links a task to a code checkout, for agent handoff.
uda.repo.type=string
uda.repo.label=Repo

# Inbox: captured tasks that still need a project, a date, or deletion.
report.inbox.description=Untriaged tasks (+in)
report.inbox.filter=status:pending -WAITING +in
report.inbox.columns=id,entry.age,description
report.inbox.labels=ID,Age,Description
report.inbox.sort=entry+

# Errands: things to do while out, ready now.
report.errands.description=Errands and calls, ready now
report.errands.filter=status:pending -WAITING (+errand or +call)
report.errands.columns=id,due.relative,tags,description
report.errands.labels=ID,Due,Tags,Description
report.errands.sort=due+,urgency-

# Inbox items stay visible but never outrank real work.
urgency.user.tag.in.coefficient=-2.0


# Brazilian holidays in `task calendar`.
include /usr/share/doc/task/rc/holidays.pt-BR.rc
calendar.holidays=sparse
calendar.details=sparse

# `start` and `stop` add a timestamped annotation, so time spent on a task is visible.
journal.time=1

# Contexts, next to the existing work and personal ones.
context.health.read=project:home.health
context.health.write=project:home.health
context.money.read=project:home.finance
context.money.write=project:home.finance
context.dev.read=project:dev
context.dev.write=project:dev

# Urgency: health and bills outrank hobby code; low-priority dev ideas sink.
urgency.user.project.home.health.coefficient=2.0
urgency.user.project.home.finance.coefficient=2.0
urgency.user.project.career.coefficient=1.5
urgency.user.tag.errand.coefficient=0.5

# Report: this week. Anything due or scheduled before next Monday.
report.week.description=Due or scheduled this week
report.week.filter=status:pending -WAITING (due.before:sow+7d or scheduled.before:sow+7d)
report.week.columns=id,due.relative,project,tags,description.count
report.week.labels=ID,Due,Project,Tags,Description
report.week.sort=due+,urgency-

# Report: bills and money owed, including hidden ones, for the month view.
report.money.description=Bills and collections, including waiting ones
report.money.filter=project:home.finance status:pending
report.money.columns=id,due,recur,tags,description.count
report.money.labels=ID,Due,Recur,Tags,Description
report.money.sort=due+

# Report: stale. Pending tasks untouched for 30 days, for the weekly review.
report.stale.description=Pending tasks not modified in 30 days
report.stale.filter=status:pending -WAITING modified.before:now-30d
report.stale.columns=id,modified.age,project,description.count
report.stale.labels=ID,Untouched,Project,Description
report.stale.sort=modified+
