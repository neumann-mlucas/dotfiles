#!/usr/bin/env sh

# welcome to the 21th century
alias cat='bat'
alias df='duf'
alias diff='delta'
alias du='dust'
alias grep='rg'
alias ls='eza -h --group-directories-first'
alias top='btop'
alias tree='erd -IH'
alias htop='btm'
alias vi='nvim'
alias vim='nvim'
alias watch='viddy'

# safety first
alias mkdir='mkdir -pv'
alias mv='mv -iv'
alias rm='rm -v'
alias cp='cp -iv'

# ls options
alias la='ls -al'                                      # all files and dirs
alias lh='ls -ald .*'                                  # only hidden
alias ll='ls -l'                                       # long format
alias lt='eza -aT --color=always | bat --color=always' # tree listing
alias lu='ls -l -s modified -r'                        # oldest first

# correct typos
alias pytohn='python'
alias pyhton='python'
alias pythno='python'
alias vu='nvim'
alias vo='nvim'
alias co='cp'
alias sl='ls'
alias mkidr='mkdir'
alias mkdri='mkdir'

# git stuff
alias g='git'
alias gti='git'
alias gbr='git branch'
alias gcm='git commit $(git ls-files -m | fzf --preview "git diff --color=always -- {}")'
alias gco='git checkout'
alias gdf='git diff'
alias gdt='git difftool'
alias gll='git log --oneline --no-merges'
alias gpl='git pull'
alias gps='git push'
alias gst='git status'

# vim stuff
alias vsp='nvim -O'
alias vdf='nvim -d'
alias vtb='nvim -p'
alias fastvim='nvim -n -u NONE -i NONE -N'

# python stuff
alias git-sim='uvx git-sim'
alias isort='uvx ruff check --select I,RUF022 --fix'
alias ppy='uvx ptpython --with pandas'
alias prek='uvx prek'
alias radon='uvx radon'
alias ruff='uvx ruff'
alias sqlfluff='uvx sqlfluff fix --dialect postgres'
alias vd='uvx --with openpyxl --with pyarrow --with psycopg2-binary visidata'
alias yt-dlp='uvx yt-dlp'

# ansible
alias ansible-maintenance="ansible-playbook -K -i ~/.ansible/inventories/hosts ~/.ansible/playbooks/maintenance.yml"
alias ansible-maintenance-server="ansible-playbook -i ~/.ansible/inventories/hosts ~/.ansible/playbooks/maintenance.yml -l homeserver -K"

# misc
alias stow-dot="stow --restow -v --no-folding --dotfiles -t ~ -d ~/.dotfiles ."
alias encf="openssl enc -e -aes256 -in"
alias decf="openssl enc -d -aes256 -in"
alias weather="curl wttr.in"
alias wifi="nmcli dev wifi show-password"
alias rss="newsraft"
alias pacman-hist="expac --timefmt='%Y-%m-%d %T' '%l\t%w\t%n' | sort"
alias hashfiles='fd -t f -0 | xargs -0 -P 0 md5sum | sort -k2'
