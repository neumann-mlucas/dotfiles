#!/usr/bin/env sh
set -eu

HYPRGAMEMODE=$(hyprctl -j getoption animations.enabled | jq -r '.bool')
if [ "$HYPRGAMEMODE" = "true" ] ; then
    hyprctl eval 'hl.config({
        animations = { enabled = false },
        decoration = {
            shadow = { enabled = false },
            blur = { enabled = false },
            rounding = 0,
        },
        general = { gaps_in = 0, gaps_out = 0, border_size = 1 },
    })'
    exit
fi
hyprctl reload
